# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local-disk storage provider (dev-only stand-in for S3/R2)
/.data/

# production launch evidence may contain real user/provider/operational details
/docs/phase8-launch-evidence.json

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled worker output
/dist

# local working artifacts (planning scratch, not project docs)
/OUTPUTS/

# private strategy document — never commit while this repository is public.
# Public git history cannot be retracted: going private later does not unpublish
# what was already crawled, archived, or forked. See DECISIONS.md, 2026-08-11,
# "Repository Stays Public Until P5". The rest of that never-commit list (margin,
# revenue, scale, acquisition, and price-positioning material, and the private
# plan's P5 Selector policy and P6 Review Agent design) is content, not a fixed
# filename, so it cannot be ignored by path — it stays in the Dropbox workspace.
/CTO.md
