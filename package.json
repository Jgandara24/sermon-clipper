{
  "name": "sermon-clipper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:legacy-exports": "tsx scripts/audit-legacy-exports.ts",
    "audit:schedule-collisions": "tsx scripts/audit-scheduled-post-collisions.ts",
    "build": "npm run prisma:generate && next build",
    "collect:launch-evidence": "tsx scripts/collect-launch-evidence.ts",
    "create:launch-evidence": "tsx scripts/create-launch-evidence.ts",
    "create:project-cost-report": "tsx scripts/create-project-cost-report.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "next dev",
    "evaluate:analysis-routing": "tsx scripts/evaluate-analysis-routing.ts",
    "launch:phase8": "tsx scripts/collect-launch-evidence.ts --require-complete",
    "lint": "eslint",
    "prepare": "git config core.hooksPath .githooks || true",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://sermon_clipper:sermon_clipper@localhost:5432/sermon_clipper?schema=public} prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://sermon_clipper:sermon_clipper@localhost:5432/sermon_clipper?schema=public} prisma validate",
    "record:launch-evidence": "tsx scripts/record-launch-evidence.ts",
    "report:project-cost": "tsx scripts/report-project-cost.ts",
    "set:analysis-routing": "tsx scripts/set-analysis-routing-policy.ts",
    "set:candidate-limit-override": "tsx scripts/set-candidate-limit-override.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run prisma:validate && npm run prisma:generate && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:benchmark": "tsx scripts/verify-editorial-benchmark.ts",
    "verify:launch-evidence": "tsx scripts/verify-launch-evidence.ts",
    "verify:project-cost": "tsx scripts/verify-project-cost-report.ts",
    "worker": "tsx watch src/worker/run-jobs.ts",
    "worker:build": "tsc --noEmit -p tsconfig.worker.json && esbuild src/worker/run-jobs.ts --bundle --platform=node --packages=external --sourcemap --outfile=dist/worker/run-jobs.cjs",
    "worker:prod": "node --enable-source-maps dist/worker/run-jobs.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/lib-storage": "^3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.1081.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.66.0",
    "@sentry/node": "^10.66.0",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
