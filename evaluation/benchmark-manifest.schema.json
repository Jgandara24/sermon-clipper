{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "string",
      "const": "1.0"
    },
    "labeledOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labeler": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "serviceOccurrence": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "SECONDARY",
            "SPECIAL"
          ]
        }
      },
      "required": [
        "artifactId",
        "sha256",
        "durationMs",
        "width",
        "height",
        "serviceOccurrence"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "SERMON",
              "WORSHIP",
              "ANNOUNCEMENT",
              "PRAYER",
              "BAPTISM",
              "OTHER_SERVICE_CONTENT",
              "PASTOR_VISIBLE",
              "FULLSCREEN_SLIDE",
              "AMBIGUOUS"
            ]
          },
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "kind",
          "startMs",
          "endMs"
        ],
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REVISE",
              "REPLACE"
            ]
          },
          "feedback": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "CONTENT",
                    "FORBIDDEN_CONTENT",
                    "BOUNDARY",
                    "VISUAL_CROP",
                    "CAPTION",
                    "AUDIO_LEVEL"
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "MINOR",
                    "MAJOR",
                    "CRITICAL"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "category",
                "severity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "range",
          "decision",
          "feedback"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "manifestVersion",
    "labeledOn",
    "labeler",
    "source",
    "regions",
    "candidates"
  ],
  "additionalProperties": false
}
