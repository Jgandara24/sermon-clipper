generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  DEV       @map("dev")
  EMAIL_OTP @map("email_otp")
  GOOGLE    @map("google")

  @@map("auth_provider")
}

enum WorkspaceRole {
  OWNER    @map("owner")
  ADMIN    @map("admin")
  EDITOR   @map("editor")
  APPROVER @map("approver")
  VIEWER   @map("viewer")

  @@map("workspace_role")
}

enum MemberStatus {
  ACTIVE  @map("active")
  INVITED @map("invited")

  @@map("member_status")
}

enum WorkspaceInvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")

  @@map("workspace_invitation_status")
}

enum SourceOrigin {
  UPLOAD @map("upload")
  URL    @map("url")

  @@map("source_origin")
}

enum ProjectStatus {
  DRAFT      @map("draft")
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  READY      @map("ready")
  FAILED     @map("failed")
  CANCELED   @map("canceled")

  @@map("project_status")
}

enum AnalysisProviderKind {
  ANTHROPIC @map("anthropic")
  OPENAI    @map("openai")
  GOOGLE    @map("google")
  HEURISTIC @map("heuristic")

  @@map("analysis_provider_kind")
}

enum AnalysisRoutingPolicyState {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@map("analysis_routing_policy_state")
}

enum WorkspaceAccessPlan {
  TRIAL @map("trial")
  PAID  @map("paid")

  @@map("workspace_access_plan")
}

enum ProcessingJobType {
  FINALIZE       @map("finalize")
  PROBE          @map("probe")
  TRANSCRIBE     @map("transcribe")
  ANALYZE        @map("analyze")
  GENERATE_CLIPS @map("generate_clips")
  PREVIEW_RENDER @map("preview_render")
  EXPORT         @map("export")
  CLEANUP        @map("cleanup")

  @@map("processing_job_type")
}

enum ProcessingJobState {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  WAITING   @map("waiting")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELED  @map("canceled")
  RETRYING  @map("retrying")
  EXPIRED   @map("expired")

  @@map("processing_job_state")
}

enum LedgerKind {
  GRANT      @map("grant")
  PROCESSING @map("processing")
  EXPORT     @map("export")
  REFUND     @map("refund")
  ADJUSTMENT @map("adjustment")

  @@map("ledger_kind")
}

enum GeneratedClipStatus {
  SUGGESTED  @map("suggested")
  KEPT       @map("kept")
  HIDDEN     @map("hidden")
  SUPERSEDED @map("superseded")

  @@map("generated_clip_status")
}

enum ExportPreset {
  MP4_1080 @map("mp4_1080")

  @@map("export_preset")
}

enum ClipApprovalState {
  DRAFT             @map("draft")
  IN_REVIEW         @map("in_review")
  APPROVED          @map("approved")
  CHANGES_REQUESTED @map("changes_requested")

  @@map("clip_approval_state")
}

enum ServiceSlot {
  PRIMARY   @map("primary")
  SECONDARY @map("secondary")
  UNMATCHED @map("unmatched")

  @@map("service_slot")
}

enum SocialPlatform {
  FACEBOOK  @map("facebook")
  INSTAGRAM @map("instagram")
  TIKTOK    @map("tiktok")
  YOUTUBE   @map("youtube")

  @@map("social_platform")
}

// Tier 3 (docs/BUSINESS_OVERVIEW.md) — mirrors Pulpit Engine's own proven
// schedule_push_status state machine naming for the same reason: not_started -> in_progress ->
// succeeded | failed, refuse to reprocess a row that already has a facebookPostId.
enum SchedulePublishStatus {
  NOT_STARTED @map("not_started")
  IN_PROGRESS @map("in_progress")
  SUCCEEDED   @map("succeeded")
  FAILED      @map("failed")
  BLOCKED     @map("blocked")
  UNFILLED    @map("unfilled")
  MISSED      @map("missed")

  @@map("schedule_publish_status")
}

enum RenderQcStatus {
  PASSED @map("passed")
  FAILED @map("failed")

  @@map("render_qc_status")
}

enum PublishAttemptState {
  INTENT        @map("intent")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
  INDETERMINATE @map("indeterminate")

  @@map("publish_attempt_state")
}

enum EditorialExceptionState {
  OPEN     @map("open")
  RESOLVED @map("resolved")

  @@map("editorial_exception_state")
}

enum NotificationChannel {
  EMAIL @map("email")
  SMS   @map("sms")

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")
  SKIPPED @map("skipped")

  @@map("notification_status")
}

enum ChannelImportPlatform {
  YOUTUBE @map("youtube")

  @@map("channel_import_platform")
}

// Wave 2 review vocabulary. `AGENT` exists so P7 can record an agent decision in the same
// table without a migration; through P2 every row is written by a human.
enum ReviewerKind {
  HUMAN @map("human")
  AGENT @map("agent")

  @@map("reviewer_kind")
}

// The three decisions of the editorial standard (docs/PULPIT_ENGINE_EDITORIAL_STANDARD.md §7).
// A bare REPLACE row is refused by the service layer: only P2.7's atomic command may write one,
// together with supersession, reserve promotion, slot rebinding, and the priority export.
enum ClipReviewDecision {
  ACCEPT  @map("accept")
  REVISE  @map("revise")
  REPLACE @map("replace")

  @@map("clip_review_decision")
}

// What the finding is about. The category decides the default actionability (S15):
// CONTENT and mid-clip FORBIDDEN_CONTENT are replace-only; every other category is revisable.
enum ReviewFeedbackCategory {
  CONTENT           @map("content")
  FORBIDDEN_CONTENT @map("forbidden_content")
  BOUNDARY          @map("boundary")
  VISUAL_CROP       @map("visual_crop")
  CAPTION           @map("caption")
  AUDIO_LEVEL       @map("audio_level")
  TITLE_HOOK        @map("title_hook")

  @@map("review_feedback_category")
}

enum ReviewFeedbackSeverity {
  BLOCKER @map("blocker")
  MAJOR   @map("major")
  MINOR   @map("minor")
  INFO    @map("info")

  @@map("review_feedback_severity")
}

// Whether the finding can be fixed by re-editing the same clip, needs a different clip, or
// records an observation that asks for nothing. Stored per row so the table-driven default in
// src/lib/review/feedback-policy.ts (P2.3) stays auditable after the table changes.
enum ReviewFeedbackActionability {
  REVISABLE     @map("revisable")
  REPLACE_ONLY  @map("replace_only")
  INFORMATIONAL @map("informational")

  @@map("review_feedback_actionability")
}

enum EditorialProgramState {
  NOT_STARTED @map("not_started")
  ACTIVE      @map("active")
  PAUSED      @map("paused")
  COMPLETED   @map("completed")

  @@map("editorial_program_state")
}

// Per-workspace position in the program. Promotion past HUMAN_ONLY is a later explicit act
// (P7); Wave 2 only reserves the vocabulary and the promotion/rollback record.
enum EditorialCohort {
  HUMAN_ONLY @map("human_only")
  ASSISTED   @map("assisted")
  AGENT_LED  @map("agent_led")

  @@map("editorial_cohort")
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @unique
  name         String?
  authProvider AuthProvider @default(DEV) @map("auth_provider")
  locale       String       @default("en")
  // Platform staff, not a workspace role. The repo's permission model is workspace-scoped, so
  // this marker is the only thing that can grant cross-workspace editorial review (P2.2). It
  // implies no billing, membership, or destructive tenant authority. Grants and revokes are
  // audited as OperationalEvent rows; this column is only the current state.
  isPlatformOperator        Boolean   @default(false) @map("is_platform_operator")
  platformOperatorGrantedAt DateTime? @map("platform_operator_granted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  ownedWorkspaces             Workspace[]           @relation("WorkspaceOwner")
  memberships                 WorkspaceMember[]
  sentWorkspaceInvites        WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  clipEdits                   ClipEdit[]
  clipApprovalRequests        ClipApproval[]
  authSessions                AuthSession[]
  resolvedEditorialExceptions EditorialException[]  @relation("EditorialExceptionResolver")
  clipReviews                 ClipReview[]          @relation("ClipReviewReviewer")
  clipReviewFeedback          ClipReviewFeedback[]  @relation("ClipReviewFeedbackAuthor")
  startedEditorialPrograms    EditorialProgram[]    @relation("EditorialProgramStarter")
  completedEditorialPrograms  EditorialProgram[]    @relation("EditorialProgramCompleter")
  promotedEditorialCohorts    EditorialProgramWorkspace[] @relation("EditorialCohortPromoter")
  rolledBackEditorialCohorts  EditorialProgramWorkspace[] @relation("EditorialCohortRollbacker")

  @@index([isPlatformOperator])
  @@map("users")
}

model AuthSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailOtpChallenge {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String
  codeHash             String             @map("code_hash")
  expiresAt            DateTime           @map("expires_at")
  consumedAt           DateTime?          @map("consumed_at")
  attempts             Int                @default(0)
  deliveryStatus       NotificationStatus @default(PENDING) @map("delivery_status")
  deliveryProvider     String?            @map("delivery_provider")
  deliveryErrorMessage String?            @map("delivery_error_message")
  sentAt               DateTime?          @map("sent_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([deliveryStatus])
  @@map("email_otp_challenges")
}

model Workspace {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  ownerId                  String    @map("owner_id") @db.Uuid
  planCode                 String    @default("trial") @map("plan_code")
  accessPlan               WorkspaceAccessPlan @default(TRIAL) @map("access_plan")
  trialStartedAt           DateTime  @default(now()) @map("trial_started_at")
  trialEndsAt              DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + interval '30 days')")) @map("trial_ends_at")
  paidAt                   DateTime? @map("paid_at")
  minuteBalance            Decimal   @default(60) @map("minute_balance") @db.Decimal(10, 2)
  stripeCustomerId         String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId     String?   @unique @map("stripe_subscription_id")
  stripeSubscriptionStatus String?   @map("stripe_subscription_status")
  stripePriceId            String?   @map("stripe_price_id")
  stripeCurrentPeriodEnd   DateTime? @map("stripe_current_period_end")
  storageUsedBytes         BigInt    @default(0) @map("storage_used_bytes")
  settings                 Json      @default("{}")
  externalRefs             Json      @default("{}") @map("external_refs")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  owner                   User                     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                 WorkspaceMember[]
  invitations             WorkspaceInvitation[]
  sourceVideos            SourceVideo[]
  projects                Project[]
  usageLedger             UsageLedger[]
  generatedClips          GeneratedClip[]
  clipScores              ClipScore[]
  exportJobs              ExportJob[]
  scriptureReferences     ScriptureReference[]
  brandTemplates          BrandTemplate[]
  clipApprovals           ClipApproval[]
  approvalNotifications   ApprovalNotification[]
  clipApprovalAuditEvents ClipApprovalAuditEvent[]
  operationalEvents       OperationalEvent[]
  billingPeriodCredits    BillingPeriodCredit[]
  channelImportSources    ChannelImportSource[]
  scheduledPosts          ScheduledPost[]
  dailyCostRollups        DailyCostRollup[]
  editorialExceptions     EditorialException[]
  clipReviews             ClipReview[]
  clipReviewFeedback      ClipReviewFeedback[]
  editorialProgramState   EditorialProgramWorkspace[]

  @@index([ownerId])
  @@map("workspaces")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("stripe_webhook_events")
}

model BillingPeriodCredit {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  stripeInvoiceId      String   @unique @map("stripe_invoice_id")
  stripeSubscriptionId String   @map("stripe_subscription_id")
  planCode             String   @map("plan_code")
  minutesGranted       Decimal  @map("minutes_granted") @db.Decimal(10, 2)
  ledgerId             String?  @map("ledger_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ledger    UsageLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([stripeSubscriptionId])
  @@map("billing_period_credits")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MemberStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                    @map("workspace_id") @db.Uuid
  email                String
  role                 WorkspaceRole
  status               WorkspaceInvitationStatus @default(PENDING)
  tokenHash            String                    @unique @map("token_hash")
  deliveryStatus       NotificationStatus        @default(PENDING) @map("delivery_status")
  deliveryProvider     String?                   @map("delivery_provider")
  deliveryErrorMessage String?                   @map("delivery_error_message")
  invitedByUserId      String                    @map("invited_by_user_id") @db.Uuid
  expiresAt            DateTime                  @map("expires_at")
  acceptedAt           DateTime?                 @map("accepted_at")
  revokedAt            DateTime?                 @map("revoked_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, createdAt])
  @@index([email, status])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model SourceVideo {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  origin         SourceOrigin
  originUrl      String?      @map("origin_url")
  filename       String?
  durationS      Decimal?     @map("duration_s") @db.Decimal(10, 2)
  sizeBytes      BigInt?      @map("size_bytes")
  width          Int?
  height         Int?
  fps            Decimal?     @db.Decimal(8, 3)
  storageKey     String?      @map("storage_key")
  audioKey       String?      @map("audio_key")
  thumbnailKey   String?      @map("thumbnail_key")
  language       String?
  srtOverrideKey String?      @map("srt_override_key")
  copyrightAckAt DateTime?    @map("copyright_ack_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects   Project[]
  transcript Transcript?

  @@index([workspaceId])
  @@map("source_videos")
}

model Transcript {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceVideoId String                   @unique @map("source_video_id") @db.Uuid
  language      String
  provider      String
  fullText      String                   @map("full_text")
  // Generated column (to_tsvector over full_text) + GIN index, added via raw SQL in the migration.
  searchVector  Unsupported("tsvector")? @map("search_vector")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  sourceVideo SourceVideo         @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]

  @@map("transcripts")
}

// word_timestamps modeled as `words` jsonb on the segment (guide §6 MVP alternative) rather than
// a separate table — see DECISIONS.md.
model TranscriptSegment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptId String   @map("transcript_id") @db.Uuid
  idx          Int
  startMs      Int      @map("start_ms")
  endMs        Int      @map("end_ms")
  text         String
  speakerLabel String?  @map("speaker_label")
  words        Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

model Project {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  name             String
  sourceVideoId    String?       @map("source_video_id") @db.Uuid
  status           ProjectStatus @default(DRAFT)
  processingConfig Json          @default("{}") @map("processing_config")
  folder           String?
  series           String?
  speaker          String?
  sermonDate       DateTime?     @map("sermon_date") @db.Date
  serviceSlot      ServiceSlot   @default(PRIMARY) @map("service_slot")
  expiresAt        DateTime?     @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceVideo           SourceVideo?           @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  processingJobs        ProcessingJob[]
  usageLedger           UsageLedger[]
  generatedClips        GeneratedClip[]
  scriptureReferences   ScriptureReference[]
  channelImportedVideos ChannelImportedVideo[]
  scheduledPosts        ScheduledPost[]
  editorialExceptions   EditorialException[]
  clipReviews           ClipReview[]

  @@index([workspaceId])
  @@index([sourceVideoId])
  @@map("projects")
}

// Master routing is versioned. Projects copy one policy into processingConfig when analysis
// starts, so later policy changes cannot alter an existing project's result.
model AnalysisRoutingPolicy {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version                Int                        @unique
  name                   String
  state                  AnalysisRoutingPolicyState @default(DRAFT)
  classificationProvider AnalysisProviderKind       @map("classification_provider")
  classificationModel    String                     @map("classification_model")
  scoringProvider        AnalysisProviderKind       @map("scoring_provider")
  scoringModel           String                     @map("scoring_model")
  promptVersion          Int                        @default(1) @map("prompt_version")
  schemaVersion          Int                        @default(1) @map("schema_version")
  activatedAt            DateTime?                  @map("activated_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  @@index([state, version])
  @@map("analysis_routing_policies")
}

// Prices are immutable, effective-dated facts. A route cannot become active without a price for
// each paid model. This supports run-date cost reports and known future price changes.
model AnalysisModelPrice {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                 AnalysisProviderKind
  model                    String
  currency                 String               @default("USD")
  effectiveFrom            DateTime             @map("effective_from")
  effectiveUntil           DateTime?            @map("effective_until")
  inputPerMillionUsd       Decimal              @map("input_per_million_usd") @db.Decimal(12, 6)
  cacheReadPerMillionUsd   Decimal?             @map("cache_read_per_million_usd") @db.Decimal(12, 6)
  cacheWritePerMillionUsd  Decimal?             @map("cache_write_per_million_usd") @db.Decimal(12, 6)
  outputPerMillionUsd      Decimal              @map("output_per_million_usd") @db.Decimal(12, 6)
  pricingSourceUrl         String               @map("pricing_source_url")
  verifiedAt               DateTime             @map("verified_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  @@unique([provider, model, effectiveFrom])
  @@index([provider, model, effectiveFrom])
  @@map("analysis_model_prices")
}

model ProcessingJob {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String             @map("project_id") @db.Uuid
  type             ProcessingJobType
  state            ProcessingJobState @default(QUEUED)
  progress         Int                @default(0)
  attempt          Int                @default(0)
  idempotencyKey   String             @unique @map("idempotency_key")
  errorCode        String?            @map("error_code")
  errorMessageUser String?            @map("error_message_user")
  minutesReserved  Decimal?           @map("minutes_reserved") @db.Decimal(10, 2)
  runAfter         DateTime           @default(now()) @map("run_after")
  workerId         String?            @map("worker_id")
  heartbeatAt      DateTime?          @map("heartbeat_at")
  maxAttempts      Int                @default(3) @map("max_attempts")
  lastErrorAt      DateTime?          @map("last_error_at")
  staleRecoveredAt DateTime?          @map("stale_recovered_at")
  startedAt        DateTime?          @map("started_at")
  finishedAt       DateTime?          @map("finished_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usageLedger UsageLedger[]

  @@index([state, type, runAfter])
  @@index([state, heartbeatAt])
  @@index([projectId])
  @@map("processing_jobs")
}

model UsageLedger {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  kind         LedgerKind
  projectId    String?    @map("project_id") @db.Uuid
  minutesDelta Decimal    @map("minutes_delta") @db.Decimal(10, 2)
  balanceAfter Decimal    @map("balance_after") @db.Decimal(10, 2)
  jobId        String?    @map("job_id") @db.Uuid
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  job                  ProcessingJob?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  billingPeriodCredits BillingPeriodCredit[]

  @@index([workspaceId, createdAt])
  @@index([projectId])
  @@map("usage_ledger")
}

model GeneratedClip {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  projectId    String              @map("project_id") @db.Uuid
  rank         Int
  startMs      Int                 @map("start_ms")
  endMs        Int                 @map("end_ms")
  title        String
  hookText     String?             @map("hook_text")
  summary      String
  status       GeneratedClipStatus @default(SUGGESTED)
  liked        Boolean?
  supersededAt DateTime?           @map("superseded_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score               ClipScore?
  edits               ClipEdit[]
  exportJobs          ExportJob[]
  scriptureReferences ScriptureReference[]
  approvals           ClipApproval[]
  scheduledPosts      ScheduledPost[]
  clipReviews         ClipReview[]         @relation("ClipReviewSubject")
  replacementReviews  ClipReview[]         @relation("ClipReviewReplacement")

  @@unique([projectId, rank])
  @@index([workspaceId])
  @@index([projectId])
  @@map("generated_clips")
}

/**
 * A calendar slot for one clip: which day it's earmarked to go out and which platform
 * it's destined for. Tier 2 — this is a plan, not an action; nothing here actually posts
 * anywhere yet (see docs/BUSINESS_OVERVIEW.md, Tier 3).
 */
model ScheduledPost {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  projectId        String?               @map("project_id") @db.Uuid
  // Nullable + SET NULL: a SUCCEEDED row is the only record a real Facebook post exists,
  // so it must survive clip regeneration (re-analysis deletes and recreates clips).
  clipId           String?               @unique @map("clip_id") @db.Uuid
  exportJobId      String?               @unique @map("export_job_id") @db.Uuid
  scheduledDate    DateTime              @map("scheduled_date") @db.Date
  platform         SocialPlatform        @default(FACEBOOK)
  publishStatus    SchedulePublishStatus @default(NOT_STARTED) @map("publish_status")
  facebookPostId   String?               @map("facebook_post_id")
  publishedAt      DateTime?             @map("published_at")
  lastErrorMessage String?               @map("last_error_message")
  // Transient publish failures re-queue with backoff instead of failing terminally;
  // FAILED is reserved for attempts exhausted (see facebook-publisher.ts).
  attemptCount     Int                   @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?             @map("next_attempt_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clip                GeneratedClip?       @relation(fields: [clipId], references: [id], onDelete: SetNull)
  exportJob           ExportJob?           @relation("ScheduledPostExport", fields: [exportJobId], references: [id], onDelete: SetNull)
  publishAttempts     PublishAttempt[]
  editorialExceptions EditorialException[]
  clipReviews         ClipReview[]

  @@index([workspaceId, scheduledDate])
  @@index([projectId])
  @@index([publishStatus, scheduledDate])
  @@map("scheduled_posts")
}

// Editor state is one versioned JSON document per save (guide §12). Each save creates a new
// row rather than updating in place, so the full edit history is preserved and optimistic
// concurrency (reject a save whose baseVersion is stale) is just "does this version already
// exist" — no separate locking needed.
model ClipEdit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clipId      String   @map("clip_id") @db.Uuid
  version     Int
  editorState Json     @map("editor_state")
  isAutosave  Boolean  @default(false) @map("is_autosave")
  savedBy     String?  @map("saved_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clip        GeneratedClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  savedByUser User?         @relation(fields: [savedBy], references: [id], onDelete: SetNull)

  @@unique([clipId, version])
  @@map("clip_edits")
}

model ClipScore {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  clipId       String   @unique @map("clip_id") @db.Uuid
  total        Int
  subscores    Json
  modelVersion String   @map("model_version")
