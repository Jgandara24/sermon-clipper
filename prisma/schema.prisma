model OperationalEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  category    String
  eventType   String   @map("event_type")
  severity    String   @default("info")
  message     String
  projectId   String?  @map("project_id") @db.Uuid
  clipId      String?  @map("clip_id") @db.Uuid
  jobId       String?  @map("job_id") @db.Uuid
  exportJobId String?  @map("export_job_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@index([projectId])
  @@index([clipId])
  @@index([jobId])
  @@index([exportJobId])
  @@map("operational_events")
}

// Rebuilt from immutable raw processing-cost events. `dimensionKey` is a stable hash of the
// project/stage/provider/model/unit dimensions and avoids PostgreSQL's nullable-unique behavior.
model DailyCostRollup {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  projectId          String?   @map("project_id") @db.Uuid
  day                DateTime  @db.Date
  dimensionKey       String    @map("dimension_key")
  stage              String
  provider           String
  model              String?
  unit               String
  quantity           Decimal   @default(0) @db.Decimal(24, 9)
  totalCostUsd       Decimal   @default(0) @map("total_cost_usd") @db.Decimal(24, 9)
  bytes              BigInt    @default(0)
  cpuTimeMs          BigInt    @default(0) @map("cpu_time_ms")
  wallTimeMs         BigInt    @default(0) @map("wall_time_ms")
  eventCount         Int       @default(0) @map("event_count")
  retryCount         Int       @default(0) @map("retry_count")
  failureCount       Int       @default(0) @map("failure_count")
  unpricedEventCount Int       @default(0) @map("unpriced_event_count")
  sourceLastEventAt  DateTime? @map("source_last_event_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day, dimensionKey])
  @@index([workspaceId, day])
  @@index([projectId, day])
  @@map("daily_cost_rollups")
}

// One row records one external publish intent and its final observed outcome. Expected clip and
// export IDs are immutable snapshots rather than live foreign keys, so evidence survives changes.
model PublishAttempt {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduledPostId     String              @map("scheduled_post_id") @db.Uuid
  expectedClipId      String?             @map("expected_clip_id") @db.Uuid
  expectedExportJobId String?             @map("expected_export_job_id") @db.Uuid
  state               PublishAttemptState @default(INTENT)
  providerPostId      String?             @map("provider_post_id")
  errorCode           String?             @map("error_code")
  errorMessage        String?             @map("error_message")
  attemptedAt         DateTime?           @map("attempted_at")
  finishedAt          DateTime?           @map("finished_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Restrict)

  @@index([scheduledPostId, createdAt])
  @@index([state, createdAt])
  @@map("publish_attempts")
}

// Exceptions retain immutable context after their nullable live links disappear. Resolution
// closes the row in place; it never deletes the evidence or replaces the snapshots.
model EditorialException {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                  @map("workspace_id") @db.Uuid
  projectId        String?                 @map("project_id") @db.Uuid
  scheduledPostId  String?                 @map("scheduled_post_id") @db.Uuid
  exceptionType    String                  @map("exception_type")
  state            EditorialExceptionState @default(OPEN)
  message          String
  projectSnapshot  Json                    @default("{}") @map("project_snapshot")
  slotSnapshot     Json                    @default("{}") @map("slot_snapshot")
  metadata         Json                    @default("{}")
  resolvedAt       DateTime?               @map("resolved_at")
  resolvedByUserId String?                 @map("resolved_by_user_id") @db.Uuid
  resolutionReason String?                 @map("resolution_reason")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduledPost ScheduledPost? @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)
  resolvedBy    User?          @relation("EditorialExceptionResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, state, createdAt])
  @@index([projectId])
  @@index([scheduledPostId])
  @@index([resolvedByUserId])
  @@map("editorial_exceptions")
}

model ChannelImportSource {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                @map("workspace_id") @db.Uuid
  platform             ChannelImportPlatform
  channelId            String                @map("channel_id")
  channelHandle        String?               @map("channel_handle")
  channelTitle         String                @map("channel_title")
  uploadsPlaylistId    String                @map("uploads_playlist_id")
  enabled              Boolean               @default(true)
  registeredAt         DateTime              @default(now()) @map("registered_at")
  lastPolledAt         DateTime?             @map("last_polled_at")
  lastPollErrorAt      DateTime?             @map("last_poll_error_at")
  lastPollErrorMessage String?               @map("last_poll_error_message")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importedVideos ChannelImportedVideo[]

  @@unique([workspaceId, platform, channelId])
  @@index([workspaceId])
  @@map("channel_import_sources")
}

// status is a plain string ("imported" | "failed", with more outcomes added by the polling
// phases) mirroring OperationalEvent.category/severity rather than a schema enum.
model ChannelImportedVideo {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelImportSourceId String   @map("channel_import_source_id") @db.Uuid
  platformVideoId       String   @map("platform_video_id")
  projectId             String?  @map("project_id") @db.Uuid
  publishedAt           DateTime @map("published_at")
  status                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  channelImportSource ChannelImportSource @relation(fields: [channelImportSourceId], references: [id], onDelete: Cascade)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([channelImportSourceId, platformVideoId])
  @@index([projectId])
  @@map("channel_imported_videos")
}
