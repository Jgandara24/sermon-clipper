// Rebuilt from immutable raw processing-cost events. `dimensionKey` is a stable hash of the
// project/stage/provider/model/unit dimensions and avoids PostgreSQL's nullable-unique behavior.
model DailyCostRollup {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  projectId          String?   @map("project_id") @db.Uuid
  day                DateTime  @db.Date
  dimensionKey       String    @map("dimension_key")
  stage              String
  provider           String
  model              String?
  unit               String
  quantity           Decimal   @default(0) @db.Decimal(24, 9)
  totalCostUsd       Decimal   @default(0) @map("total_cost_usd") @db.Decimal(24, 9)
  bytes              BigInt    @default(0)
  cpuTimeMs          BigInt    @default(0) @map("cpu_time_ms")
  wallTimeMs         BigInt    @default(0) @map("wall_time_ms")
  eventCount         Int       @default(0) @map("event_count")
  retryCount         Int       @default(0) @map("retry_count")
  failureCount       Int       @default(0) @map("failure_count")
  unpricedEventCount Int       @default(0) @map("unpriced_event_count")
  sourceLastEventAt  DateTime? @map("source_last_event_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day, dimensionKey])
  @@index([workspaceId, day])
  @@index([projectId, day])
  @@map("daily_cost_rollups")
}

// One row records one external publish intent and its final observed outcome. Expected clip and
// export IDs are immutable snapshots rather than live foreign keys, so evidence survives changes.
model PublishAttempt {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduledPostId     String              @map("scheduled_post_id") @db.Uuid
  expectedClipId      String?             @map("expected_clip_id") @db.Uuid
  expectedExportJobId String?             @map("expected_export_job_id") @db.Uuid
  state               PublishAttemptState @default(INTENT)
  providerPostId      String?             @map("provider_post_id")
  errorCode           String?             @map("error_code")
  errorMessage        String?             @map("error_message")
  attemptedAt         DateTime?           @map("attempted_at")
  finishedAt          DateTime?           @map("finished_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Restrict)

  @@index([scheduledPostId, createdAt])
  @@index([state, createdAt])
  @@map("publish_attempts")
}

// Exceptions retain immutable context after their nullable live links disappear. Resolution
// closes the row in place; it never deletes the evidence or replaces the snapshots.
model EditorialException {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                  @map("workspace_id") @db.Uuid
  projectId        String?                 @map("project_id") @db.Uuid
  scheduledPostId  String?                 @map("scheduled_post_id") @db.Uuid
  exceptionType    String                  @map("exception_type")
  state            EditorialExceptionState @default(OPEN)
  message          String
  projectSnapshot  Json                    @default("{}") @map("project_snapshot")
  slotSnapshot     Json                    @default("{}") @map("slot_snapshot")
  metadata         Json                    @default("{}")
  resolvedAt       DateTime?               @map("resolved_at")
  resolvedByUserId String?                 @map("resolved_by_user_id") @db.Uuid
  resolutionReason String?                 @map("resolution_reason")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduledPost ScheduledPost? @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)
  resolvedBy    User?          @relation("EditorialExceptionResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, state, createdAt])
  @@index([projectId])
  @@index([scheduledPostId])
  @@index([resolvedByUserId])
  @@map("editorial_exceptions")
}

// The standard of record: one human decision about one exact deliverable file
// (docs/PULPIT_ENGINE_EDITORIAL_STANDARD.md §7). Rows are append-only — a database trigger
// refuses UPDATE and DELETE, so a decision is corrected by appending a newer one, never by
// rewriting this one. The trigger's single exemption is a referential SET NULL that clears a
// live foreign key; the `*Snapshot` columns beside each live link keep the evidence readable
// after the clip, export, slot, or user is gone.
//
// The reviewed clip is also the *prior* clip of a REPLACE: `replacement*` names the reserve
// that P2.7 promotes in the same transaction, and stays null for ACCEPT and REVISE.
model ClipReview {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  // Live links. Every one is nullable and SET NULL: the evidence outlives the row it points at.
  projectId            String? @map("project_id") @db.Uuid
  scheduledPostId      String? @map("scheduled_post_id") @db.Uuid
  clipId               String? @map("clip_id") @db.Uuid
  exportJobId          String? @map("export_job_id") @db.Uuid
  replacementClipId    String? @map("replacement_clip_id") @db.Uuid
  replacementExportId  String? @map("replacement_export_id") @db.Uuid
  reviewerUserId       String? @map("reviewer_user_id") @db.Uuid

  reviewerKind ReviewerKind       @default(HUMAN) @map("reviewer_kind")
  decision     ClipReviewDecision

  // Immutable identity of what was reviewed. P2.8 gates delivery on an exact match of all four
  // of clip, edit version, the slot's bound export, and the QC-time checksum.
  projectIdSnapshot       String @map("project_id_snapshot") @db.Uuid
  scheduledPostIdSnapshot String @map("scheduled_post_id_snapshot") @db.Uuid
  clipIdSnapshot          String @map("clip_id_snapshot") @db.Uuid
  clipRank                Int    @map("clip_rank")
  clipStartMs             Int    @map("clip_start_ms")
  clipEndMs               Int    @map("clip_end_ms")
  exportJobIdSnapshot     String @map("export_job_id_snapshot") @db.Uuid
  editVersion             Int    @map("edit_version")
  checksum                String

  // Immutable identity of the reserve a REPLACE promoted. Null for ACCEPT and REVISE, and null
  // for the REPLACE that found no reserve and left the slot UNFILLED.
  replacementClipIdSnapshot     String? @map("replacement_clip_id_snapshot") @db.Uuid
  replacementClipRank           Int?    @map("replacement_clip_rank")
  replacementClipStartMs        Int?    @map("replacement_clip_start_ms")
  replacementClipEndMs          Int?    @map("replacement_clip_end_ms")
  replacementExportJobIdSnapshot String? @map("replacement_export_job_id_snapshot") @db.Uuid

  // Scheduled date, platform, title, and hook as they read at decision time. Context for
  // replay and for the review UI; never an eligibility input.
  slotSnapshot Json @default("{}") @map("slot_snapshot")
  note         String?
  metadata     Json @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduledPost     ScheduledPost? @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)
  clip              GeneratedClip? @relation("ClipReviewSubject", fields: [clipId], references: [id], onDelete: SetNull)
  exportJob         ExportJob?     @relation("ClipReviewSubjectExport", fields: [exportJobId], references: [id], onDelete: SetNull)
  replacementClip   GeneratedClip? @relation("ClipReviewReplacement", fields: [replacementClipId], references: [id], onDelete: SetNull)
  replacementExport ExportJob?     @relation("ClipReviewReplacementExport", fields: [replacementExportId], references: [id], onDelete: SetNull)
  reviewer          User?          @relation("ClipReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  feedback          ClipReviewFeedback[]

  @@index([workspaceId, createdAt])
  @@index([scheduledPostIdSnapshot, createdAt])
  @@index([exportJobIdSnapshot, decision, createdAt])
  @@index([clipIdSnapshot, createdAt])
  @@index([decision, createdAt])
  @@index([projectId])
  @@index([scheduledPostId])
  @@index([clipId])
  @@index([exportJobId])
  @@index([replacementClipId])
  @@index([replacementExportId])
  @@index([reviewerUserId])
  @@map("clip_reviews")
}

// Findings hang off a review and are appended independently of it, without a practical limit:
// a reviewer may add more findings hours after the decision. Append-only under the same
// trigger as ClipReview. `actionability` is stored per row so a later change to the S15
// default table cannot rewrite what a past finding demanded.
model ClipReviewFeedback {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clipReviewId String @map("clip_review_id") @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid

  category      ReviewFeedbackCategory
  severity      ReviewFeedbackSeverity      @default(MAJOR)
  actionability ReviewFeedbackActionability
  note          String

  // Optional location of the finding inside the reviewed clip, in clip-relative milliseconds.
  startMs Int? @map("start_ms")
  endMs   Int? @map("end_ms")

  authorKind   ReviewerKind @default(HUMAN) @map("author_kind")
  authorUserId String?      @map("author_user_id") @db.Uuid
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")

  clipReview ClipReview @relation(fields: [clipReviewId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author     User?      @relation("ClipReviewFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([clipReviewId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([category, createdAt])
  @@index([actionability, createdAt])
  @@index([authorUserId])
  @@map("clip_review_feedback")
}

// Durable state of the fixed human-only reference phase (P2.9). One row per program, keyed by
// `key`, so the clock survives deploys and cannot be inferred from review rows. The start is an
// explicit recorded act; `pausedMs` accumulates so a pause extends the phase and never shortens
// it. `startEvidence` holds the smoke-test and sandbox-publication proof the start required.
model EditorialProgram {
  key               String                @id
  state             EditorialProgramState @default(NOT_STARTED)
  minimumDays       Int                   @default(30) @map("minimum_days")
  startedAt         DateTime?             @map("started_at")
  startedByUserId   String?               @map("started_by_user_id") @db.Uuid
  pausedAt          DateTime?             @map("paused_at")
  pausedMs          BigInt                @default(0) @map("paused_ms")
  completedAt       DateTime?             @map("completed_at")
  completedByUserId String?               @map("completed_by_user_id") @db.Uuid
  startEvidence     Json                  @default("{}") @map("start_evidence")
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  startedBy   User?                       @relation("EditorialProgramStarter", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completedBy User?                       @relation("EditorialProgramCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  workspaces  EditorialProgramWorkspace[]

  @@index([state])
  @@index([startedByUserId])
  @@index([completedByUserId])
  @@map("editorial_programs")
}

// One workspace's position in a program. Promotion past HUMAN_ONLY and rollback back to it are
// both explicit acts with an actor and a reason; this row is current state, and the audit trail
// is the matching OperationalEvent.
model EditorialProgramWorkspace {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programKey  String @map("program_key")
  workspaceId String @map("workspace_id") @db.Uuid

  cohort              EditorialCohort @default(HUMAN_ONLY)
  promotedAt          DateTime?       @map("promoted_at")
  promotedByUserId    String?         @map("promoted_by_user_id") @db.Uuid
  rolledBackAt        DateTime?       @map("rolled_back_at")
  rolledBackByUserId  String?         @map("rolled_back_by_user_id") @db.Uuid
  reason              String?
  metadata            Json            @default("{}")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  program      EditorialProgram @relation(fields: [programKey], references: [key], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  promotedBy   User?            @relation("EditorialCohortPromoter", fields: [promotedByUserId], references: [id], onDelete: SetNull)
  rolledBackBy User?            @relation("EditorialCohortRollbacker", fields: [rolledBackByUserId], references: [id], onDelete: SetNull)

  @@unique([programKey, workspaceId])
  @@index([workspaceId])
  @@index([cohort])
  @@index([promotedByUserId])
  @@index([rolledBackByUserId])
  @@map("editorial_program_workspaces")
}

model ChannelImportSource {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                @map("workspace_id") @db.Uuid
  platform             ChannelImportPlatform
  channelId            String                @map("channel_id")
  channelHandle        String?               @map("channel_handle")
  channelTitle         String                @map("channel_title")
  uploadsPlaylistId    String                @map("uploads_playlist_id")
  enabled              Boolean               @default(true)
  registeredAt         DateTime              @default(now()) @map("registered_at")
  lastPolledAt         DateTime?             @map("last_polled_at")
  lastPollErrorAt      DateTime?             @map("last_poll_error_at")
  lastPollErrorMessage String?               @map("last_poll_error_message")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importedVideos ChannelImportedVideo[]

  @@unique([workspaceId, platform, channelId])
  @@index([workspaceId])
  @@map("channel_import_sources")
}

// status is a plain string ("imported" | "failed", with more outcomes added by the polling
// phases) mirroring OperationalEvent.category/severity rather than a schema enum.
model ChannelImportedVideo {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelImportSourceId String   @map("channel_import_source_id") @db.Uuid
  platformVideoId       String   @map("platform_video_id")
  projectId             String?  @map("project_id") @db.Uuid
  publishedAt           DateTime @map("published_at")
  status                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  channelImportSource ChannelImportSource @relation(fields: [channelImportSourceId], references: [id], onDelete: Cascade)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([channelImportSourceId, platformVideoId])
  @@index([projectId])
  @@map("channel_imported_videos")
}
