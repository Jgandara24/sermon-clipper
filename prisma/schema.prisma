  startedAt        DateTime?          @map("started_at")
  finishedAt       DateTime?          @map("finished_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  clip                 GeneratedClip  @relation(fields: [clipId], references: [id], onDelete: Cascade)
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outputFile           ExportedFile?  @relation(fields: [outputFileId], references: [id], onDelete: SetNull)
  scheduledPostBinding ScheduledPost? @relation("ScheduledPostExport")
  clipReviews          ClipReview[]   @relation("ClipReviewSubjectExport")
  replacementReviews   ClipReview[]   @relation("ClipReviewReplacementExport")

  @@index([workspaceId, createdAt])
  @@index([state, runAfter])
  @@index([state, heartbeatAt])
  @@index([clipId])
  @@map("export_jobs")
}

model ExportedFile {
